{
  "platform": {
    "apiRuntime": "python:3.11"
  },
  "routes": [
    {
      "route": "/api/suggest",
      "methods": ["POST"],
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/google?post_login_redirect_uri=/suggest/",
      "statusCode": 302
    }
  }
}
